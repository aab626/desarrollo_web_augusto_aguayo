{% extends 'base.html.j2' %}
{% block title %} Inicio {% endblock %}

{% block main_content %}

{% if listing_success %}
<div class="listing-success-section">
    <p class="listing-success-text">El aviso de adopción fue agregado correctamente!</p>
</div>
{% else %}
<div class="welcome-section">
    <p class="welcome-text">Bienvenido!</p>
</div>
{% endif %}

<h2 class="section-title">Avisos más recientes</h2>

<table class="data-table recent-posts-table">
    <thead>
        <tr>
            <th class="table-header">Fecha publicación</th>
            <th class="table-header">Comuna</th>
            <th class="table-header">Sector</th>
            <th class="table-header">
                <div>Cantidad Tipo</div>
                <div>Edad</div>
            </th>
            <th class="table-header">Foto</th>
        </tr>
    </thead>
    <tbody>
        {% for listing in listings %}

        <tr class="table-row">
            <td class="table-cell date-cell">{{ listing.fecha_ingreso }}</td>
            <td class="table-cell">{{ listing.comuna.nombre }}</td>
            <td class="table-cell">{{ listing.sector }}</td>
            <td class="table-cell pet-info">
                <div class="pet-quantity">{{ listing.cantidad }} {{ listing.tipo }}</div>
                <div class="pet-age">
                    {{listing.edad}}
                    {% if listing.edad == 1 %}
                        {% if listing.unidad_medida == "a" %}año{% elif listing.unidad_medida == "m" %}mes{% else %}ERROR{% endif %}
                    {% else %}
                        {% if listing.unidad_medida == "a" %}años{% elif listing.unidad_medida == "m" %}meses{% else %}ERROR{% endif %}
                    {% endif %}
                </div>
            </td>
            <td class="table-cell photo-cell"><img src="{{ url_for('static', filename='uploads/' ~ photo_dict[listing.id].nombre_archivo) }}" width="200" alt="Imagen del aviso" class="pet-photo"></td>
        </tr>

        {% endfor %}
    </tbody>
</table>
{% endblock %}

{% block body_scripts %}
{% endblock %}