{% extends 'base.html.j2' %}
{% block title %} Avisos Publicados {% endblock %}

{% block main_content %}
<main class="main-content">
    <h2 class="section-title">Aviso de adopción</h2>

    <div class="post-container">
        <!-- Pet Photos Section -->
        <section class="post-photos-section">
            <h3 class="section-heading">Fotos</h3>
            <div class="photos-grid photos-count-{{ listing.fotos|length }}">
                {% for photo in listing.fotos %}
                    <img 
                        src="{{ url_for('static', filename='uploads/' ~ photo.nombre_archivo) }}" 
                        alt="Foto {{ loop.index }} del aviso"
                        class="post-photo photo-thumbnail"
                        data-fullsize="{{ url_for('static', filename='uploads/' ~ photo.nombre_archivo) }}"
                    >
                {% endfor %}
            </div>
        </section>

        <!-- Pet Information Section -->
        <section class="post-section pet-details-section">
            <h3 class="section-heading">Información de la mascota</h3>
            <div class="pet-details">
                <div class="detail-row">
                    <span class="detail-label">Tipo:</span>
                    <span class="detail-value">{{ listing.tipo|capitalize }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Cantidad:</span>
                    <span class="detail-value">{{ listing.cantidad }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Edad:</span>
                    <span class="detail-value">
                        {{listing.edad}}
                        {% if listing.edad == 1 %}
                            {% if listing.unidad_medida == "a" %}año{% elif listing.unidad_medida == "m" %}mes{% else %}ERROR{% endif %}
                        {% else %}
                            {% if listing.unidad_medida == "a" %}años{% elif listing.unidad_medida == "m" %}meses{% else %}ERROR{% endif %}
                        {% endif %}
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Fecha disponible de entrega:</span>
                    <span class="detail-value">{{ listing.fecha_entrega.strftime('%d de %B de %Y, %H:%M') }}</span>
                </div>
            </div>
        </section>

        <!-- Description Section -->
        <section class="post-section description-section">
            <h3 class="section-heading">Descripción</h3>
            <div class="description-content">
                <p class="description-text">
                    {{ listing.descripcion }}
                </p>
            </div>
        </section>

        <!-- Location Section -->
        <section class="post-section location-section">
            <h3 class="section-heading">Ubicación</h3>
            <div class="location-details">
                <div class="detail-row">
                    <span class="detail-label">Comuna:</span>
                    <span class="detail-value">{{ listing.comuna.nombre }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Sector:</span>
                    <span class="detail-value">{{ listing.sector }}</span>
                </div>
            </div>
        </section>

        <!-- Contact Information Section -->
        <section class="post-section contact-section">
            <h3 class="section-heading">Información de contacto</h3>
            <div class="contact-details">
                <div class="detail-row">
                    <span class="detail-label">Nombre:</span>
                    <span class="detail-value">{{ listing.nombre }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Email:</span>
                    <span class="detail-value">{{ listing.email }}</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Teléfono:</span>
                    <span class="detail-value">{{ listing.celular }}</span>
                </div>

                <div class="contact-methods">
                    <h4 class="contact-methods-title">Métodos de contacto preferidos:</h4>

                    <table class="contact-methods-table">
                        <tbody>
                            {% for contact_method in listing.contactos %}
                            <tr class="contact-method-detail-row">
                                <td class="contact-method-icon">
                                    {% if contact_method.nombre == 'whatsapp' %}
                                        <img class="icon icon-whatsapp" src="{{ url_for('static', filename='svg/whatsapp-brands-solid-full.svg') }}" alt="WhatsApp">
                                    {% elif contact_method.nombre == 'telegram' %}
                                        <img class="icon icon-telegram" src="{{ url_for('static', filename='svg/telegram-brands-solid-full.svg') }}" alt="Telegram">
                                    {% elif contact_method.nombre == 'x' %}
                                        <img class="icon icon-x" src="{{ url_for('static', filename='svg/x-twitter-brands-solid-full.svg') }}" alt="X">
                                    {% elif contact_method.nombre == 'instagram' %}
                                        <img class="icon icon-instagram" src="{{ url_for('static', filename='svg/instagram-brands-solid-full.svg') }}" alt="Instagram">
                                    {% elif contact_method.nombre == 'tiktok' %}
                                        <img class="icon icon-tiktok" src="{{ url_for('static', filename='svg/tiktok-brands-solid-full.svg') }}" alt="TikTok">
                                    {% else %}
                                        <img class="icon icon-otro" src="{{ url_for('static', filename='svg/address-book-solid-full.svg') }}" alt="Otro">
                                    {% endif %}
                                </td>
                                <td class="contact-method-type">{{ contact_method.nombre|capitalize }}:</td>
                                <td class="contact-method-value">{{ contact_method.identificador }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Publication Information -->
        <section class="post-section publication-info">
            <h3 class="section-heading">Información de publicación</h3>
            <div class="publication-details">
                <div class="detail-row">
                    <span class="detail-label">Fecha de publicación:</span>
                    <span class="detail-value">{{ listing.fecha_ingreso.strftime('%d de %B de %Y, %H:%M') }}</span>
                </div>
            </div>
        </section>

        <!-- Action Buttons -->
        <div class="post-actions">
            <button type="button" id="btn-footer-nav-listings" class="btn btn-secondary">Ver más avisos</button>
            <button type="button" id="btn-footer-nav-index" class="btn btn-secondary">Volver al inicio</button>
        </div>
    </div>
</main>
{% endblock %}

{% block body_modals %}
    <!-- Image Modal -->
    <div id="imageModal" class="modal image-modal" hidden>
        <div class="modal-overlay modal-close"></div>
        <div class="modal-content image-modal-content">
            <div class="modal-header">
                <span class="modal-close-text modal-close">Cerrar</span>
            </div>
    
            <div class="modal-body image-modal-body">
                <img id="modalImage" src="" alt="Imagen ampliada" class="modal-image">
            </div>
        </div>
    </div>
{% endblock %}

{% block body_scripts %}
<script src="{{ url_for('static', filename='js/post-handler.js') }}"></script>
{% endblock %}
