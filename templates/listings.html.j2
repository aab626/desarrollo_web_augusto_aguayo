{% extends 'base.html.j2' %}
{% block title %} Estadísticas {% endblock %}

{% block main_content %}
{# {{page_data}} #}
<h2 class="section-title">Avisos Publicados</h2>

<!-- Location data -->
<table class="data-table listings-table">
    <thead>
        <tr>
            <th class="table-header">Fecha Publicación</th>
            <th class="table-header">Fecha Entrega</th>
            <th class="table-header">Comuna</th>
            <th class="table-header">Sector</th>
            <th class="table-header">
                <div>Cantidad</div>
                <div>Tipo</div>
                <div>Edad</div>
            </th>
            <th class="table-header">
                <div>Nombre</div>
                <div>Contacto</div>
            </th>
            <th class="table-header">Total Fotos</th>
        </tr>
    </thead>
    <tbody>
    <tbody>
        {% for listing in page_data.data %}
            <tr class="table-row">
                <td class="table-cell date-cell">{{ listing.fecha_ingreso }}</td>
                <td class="table-cell date-cell">{{ listing.fecha_entrega }}</td>
                <td class="table-cell">{{ listing.comuna.nombre }}</td>
                <td class="table-cell">{{ listing.sector }}</td>
                <td class="table-cell pet-info">
                    <div class="pet-quantity">{{ listing.cantidad }}</div>
                    <div class="pet-type">{{ listing.tipo|capitalize }}</div>
                    <div class="pet-age">
                        {{listing.edad}}
                        {% if listing.edad == 1 %}
                            {% if listing.unidad_medida == "a" %}año
                            {% elif listing.unidad_medida == "m" %}mes
                            {% else %}ERROR
                            {% endif %}
                        {% else %}
                            {% if listing.unidad_medida == "a" %}años
                            {% elif listing.unidad_medida == "m" %}meses
                            {% else %}ERROR
                            {% endif %}
                        {% endif %}
                    </div>
                </td>
                <td class="table-cell contact-info">
                    <div class="contact-name">{{ listing.nombre }}</div>
            
                    <div class="contact-method">
                        <div class="contact-type">{{ listing.contactos[0].nombre|capitalize }}</div>
                        <div class="contact-value">{{ listing.contactos[0].identificador }}</div>
                    </div>
                </td>
                <td class="table-cell photo-count">{{ listing.fotos|length }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<nav class="pagination">
    <div class="pagination-buttons">
        <form class="pagination-form" action="{{ url_for('listings') }}" method="get">
            {% if page_data.has_prev_page %}
                <input type="hidden" name="page" value="{{ page_data.prev_page }}">
                <button type="submit" class="btn btn-secondary btn-page" id="listing-prev-page-button">« Anterior</button>
            {% else %}
                <button type="button" class="btn btn-secondary btn-page" id="listing-prev-page-button" disabled>« Anterior</button>
            {% endif %}
        </form>

        <span class="pagination-status">Página {{ page_data.page }}</span>

        <form class="pagination-form" action="{{ url_for('listings') }}" method="get">
            {% if page_data.has_next_page %}
                <input type="hidden" name="page" value="{{ page_data.next_page }}">
                <button type="submit" class="btn btn-secondary btn-page" id="listing-next-page-button">Siguiente »</button>
            {% else %}
                <button type="button" class="btn btn-secondary btn-page" id="listing-next-page-button" disabled>Siguiente »</button>
            {% endif %}
        </form>
    </div>
</nav>

{% endblock %}

{% block body_scripts %}
{% endblock %}
